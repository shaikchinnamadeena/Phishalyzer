
# ==========================================
# PHISHALYZER - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=Phishalyzer
APP_ENV=development
LOG_LEVEL=INFO

# VirusTotal API
VIRUSTOTAL_API_KEY=

# URLScan.io API
URLSCAN_API_KEY=

# Analysis configuration
REQUEST_TIMEOUT=10
MAX_REDIRECTS=5

# Risk scoring thresholds
RISK_LOW_MAX=24
RISK_MODERATE_MAX=49
RISK_HIGH_MAX=74
RISK_CRITICAL_MAX=100

